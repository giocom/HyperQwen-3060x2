# ==========================================
# HyperQwen - 2x RTX 3060 (12GB) MAX_SEQS=4 & 최대 컨텍스트(192K) 최적화 설정
# ==========================================
# 1. GPU 장치 지정
GPU_COUNT=2
CUDA_DEVICE_ORDER=PCI_BUS_ID
CUDA_VISIBLE_DEVICES=0,1

# 2. 멀티 GPU (TP=2 + P2P Custom All-Reduce 활성화) 및 스케줄링 최적화
EXTRA_ARGS="--tensor-parallel-size 2 --long-prefill-token-threshold 1024 --limit-mm-per-prompt.image 32 --uvicorn-log-level warning"

# 3. 어텐션 & GEMM 가속 (PTH_FA 커스텀 INT8 KV 커널 + W4A8 Marlin MLP + 임베딩 UVA 오프로드)
PTH_FA=1
INT8_ACT=int8
INT8_LAYERS=mlp
EMBED_UVA=1

# 4. 최대 컨텍스트(196,608 = 192K) 및 동시 요청(MAX_SEQS=4) CUDA Graph 최적화
# GPU KV cache size: 198,912 tokens, Maximum concurrency for 196,608 tokens per request: 1.01x
# VRAM : 11161MiB /  12288MiB
#MAX_LEN=196608
#GPU_UTIL=0.91
#VISION=1
#VISION_OFFLOAD=1

# GPU KV cache size: 181,458 tokens, Maximum concurrency for 153,600 tokens per request: 1.18x
# VRAM : 11133MiB /  12288MiB
#MAX_LEN=150000
#GPU_UTIL=0.89
#VISION=1
#VISION_OFFLOAD=1

# VRAM : GPU KV cache size: 137,774 tokens, Maximum concurrency for 131,072 tokens per request: 1.05x
# VRAM : 10361MiB /  12288MiB
MAX_LEN=131072
GPU_UTIL=0.825
VISION=1
VISION_OFFLOAD=1

# MAX_SEQS=4, DRAFT_TOKENS=3 -> 요청당 4토큰 검증 -> 최대 4*4=16 토큰 배칭 (CG=16)
MAX_SEQS=4
SPEC=mtp
CTX=long
DRAFT_TOKENS=3
CG=16

VERIFY=0
REQ_METRICS=1
PREFIX_CACHE=1
VLLM_LOGGING_LEVEL=INFO
NCCL_P2P_LEVEL=PHB
NCCL_P2P_DISABLE=0
MODEL=/app/models/ThinkingCap-Qwen3.8-27B-AutoRound-W4A16-fast
